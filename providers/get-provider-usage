extract_antigravity_keyring_token() {
  jq -r '
    def token_string:
      if type == "object" then
        .access_token // .accessToken // .token // .Token // empty
      elif type == "string" and test("^ya29\\.") then
        .
      else
        empty
      end;
    if type == "object" then
      (.token | token_string)
      // token_string
      // empty
    else
      token_string
    end
  ' 2>/dev/null || true
}

extract_antigravity_keyring_account() {
  jq -r '
    if type == "object" then
      .email // .account_email // (.token.email // .token.account_email // empty) // "Antigravity CLI"
    else
      "Antigravity CLI"
    end
  ' 2>/dev/null || printf 'Antigravity CLI'
}

# A Google refresh token in a keyring oauth2.Token JSON payload (stdin).
extract_antigravity_keyring_refresh() {
  jq -r '
    if type == "object" then
      (.refresh_token // .refreshToken // .token.refresh_token // .token.refreshToken // empty)
    else empty end
  ' 2>/dev/null || true
}

# A signed-in Antigravity IDE stores its OAuth profile in state.vscdb. The exact
# key and encoding differ across builds: the current build uses
# antigravityUnifiedStateSync.oauthToken (base64 protobuf whose nested string
# field is itself base64), older builds use jetskiStateSync.agentManagerInitState
# (single base64 layer). Access tokens in those blobs are short-lived and usually
# stale by the time a background widget reads them, so we recover the long-lived
# Google refresh token (1//...) — peeling up to two base64 layers across the
# auth-bearing keys — and mint a fresh access token instead. Never emits the
# secret. Prints the first refresh token found, or nothing.
extract_antigravity_idedb_refresh() {
  local db="$1"
  [ -r "$db" ] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0
  sqlite3 "$db" "select value from ItemTable where key like '%oauth%' or key like '%Auth%' or key like '%ync%' or key like '%jetski%';" 2>/dev/null \
    | while IFS= read -r value; do
        # direct, then single base64 layer, then a nested base64 blob.
        printf '%s' "$value" | grep -aoE '1//[A-Za-z0-9_-]{30,}'
        printf '%s' "$value" | base64 -d 2>/dev/null | strings | grep -aoE '1//[A-Za-z0-9_-]{30,}'
        printf '%s' "$value" | base64 -d 2>/dev/null | strings | grep -oE 'Co[A-Za-z0-9+/=]{40,}' \
          | while IFS= read -r blob; do printf '%s' "$blob" | base64 -d 2>/dev/null | grep -aoE '1//[A-Za-z0-9_-]{30,}'; done
      done | grep -aoE '1//[A-Za-z0-9_-]{30,}' | head -1
}

# Exchange a refresh token for a fresh access token (+ id_token) via Google's
# public OAuth token endpoint, using the Cloud Code client credentials that
# ship embedded in the Antigravity IDE / gemini-cli bundle (not secrets — any
# install exposes them; overridable for testing or credential rotation).
# Writes "access_token<TAB>id_token" to stdout on success, nothing on failure.
antigravity_refresh_access_token() {
  local refresh="$1"
  [ -n "$refresh" ] || return 0
  local client_id client_secret token_url tmp_body http_status message
  client_id="${ANTIGRAVITY_OAUTH_CLIENT_ID:-1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com}"
  client_secret="${ANTIGRAVITY_OAUTH_CLIENT_SECRET:-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}"
  token_url="${ANTIGRAVITY_TOKEN_URL:-https://oauth2.googleapis.com/token}"
  tmp_body="$(mktemp)"
  # Feed the refresh token over stdin. refresh_token@- keeps the secret out
  # of argv/process listings while curl still form-encodes it in the TLS body.
  if ! http_status="$(printf '%s' "$refresh" | curl -sS --max-time 10 -X POST "$token_url" \
      -o "$tmp_body" -w '%{http_code}' \
      --data-urlencode "client_id=${client_id}" \
      --data-urlencode "client_secret=${client_secret}" \
      --data-urlencode "refresh_token@-" \
      --data-urlencode "grant_type=refresh_token" 2>/dev/null)"; then
    rm -f "$tmp_body"
    printf '1\tAntigravity OAuth token refresh could not reach Google.\n' >&2
    return 1
  fi
  if [ "$http_status" != "200" ]; then
    message="$(jq -r '.error_description // .error.message // .message // empty' "$tmp_body" 2>/dev/null || true)"
    [ -n "$message" ] || message="Antigravity OAuth token refresh returned HTTP ${http_status:-0}."
    rm -f "$tmp_body"
    printf '%s\t%s\n' "${http_status:-1}" "$message" >&2
    return 1
  fi
  if ! jq -e '.access_token | type == "string" and length > 0' "$tmp_body" >/dev/null 2>&1; then
    rm -f "$tmp_body"
    printf '1\tAntigravity OAuth token response schema changed: access_token is missing.\n' >&2
    return 1
  fi
  jq -r '"\(.access_token)\t\(.id_token // "")"' "$tmp_body"
  rm -f "$tmp_body"
}

# Decode the email claim from an OAuth id_token JWT (no signature check — used
# only as a display label). Prints the email or nothing.
antigravity_email_from_idtoken() {
  local idt="$1" payload pad
  [ -n "$idt" ] || return 0
  payload="$(printf '%s' "$idt" | cut -d. -f2)"
  [ -n "$payload" ] || return 0
  pad=$(( (4 - ${#payload} % 4) % 4 ))
  payload="${payload}$(printf '=%.0s' $(seq 1 "$pad" 2>/dev/null))"
  printf '%s' "$payload" | tr '_-' '/+' | base64 -d 2>/dev/null | jq -r '.email // empty' 2>/dev/null || true
}

# Map one retrieveUserQuotaSummary payload (stdin) to a single account object.
# Args: install label, account email, login method. retrieveUserQuotaSummary is
# the endpoint the IDE itself renders — it returns the model quota pools (each
# with a per-week and per-5-hour cap, surfacing the one closest to its limit),
# their reset times and human "Quota resets in …" strings.
antigravity_account_json() {
  jq -c --arg install "$1" --arg email "$2" --arg login "$3" '
    def clamp: if type != "number" then 0 elif . < 0 then 0 elif . > 1 then 1 else . end;
    def num: (tonumber? // null);
    def fam: (.displayName // .bucketId // "Model") | gsub("\\s*\\([^)]*\\)\\s*$"; "");
    def group_label($g):
      ($g.displayName // "Models") as $raw
      | if ($raw | test("gemini"; "i")) then "Gemini Models"
        elif ($raw | test("claude|openai|gpt|3p"; "i")) then "Claude & OpenAI Models"
        else $raw end;
    def group_rank($label):
      if ($label | test("^Gemini"; "i")) then 0
      elif ($label | test("^Claude|OpenAI|GPT"; "i")) then 1
      else 2 end;
    def window_kind:
      ((.window // .displayName // .bucketId // "") | ascii_downcase) as $raw
      | if ($raw | test("(^|[^a-z0-9])5[ -]?(h|hour)")) then
          {id:"5h", label:"5h", minutes:300, rank:0}
        elif ($raw | test("week|(^|[^a-z0-9])7[ -]?d")) then
          {id:"weekly", label:"Weekly", minutes:10080, rank:1}
        else null end;

    ([.groups[]?.buckets[]? | select((window_kind) != null)] | length > 0) as $summary_shape
    | (if $summary_shape then
      [
        .groups[]? as $g
        | group_label($g) as $gl
        | $g.buckets[]?
        | (window_kind) as $kind
        | select($kind != null)
        | (.remainingFraction | num) as $remaining
        | select($remaining != null)
        | ($remaining | clamp) as $rem
        | ($gl + " (" + $kind.label + ")") as $name
        | {
            name: $name,
            group: $gl,
            window: $kind.id,
            windowMinutes: $kind.minutes,
            usedPercent: (((1 - $rem) * 10000 | round) / 100),
            resetsAt: (.resetTime // null),
            resetDescription: $name,
            description: (.description // null),
            displayValue: null,
            _groupRank: group_rank($gl),
            _windowRank: $kind.rank
          }
      ]
      | sort_by([._groupRank, ._windowRank])
      | map(del(._groupRank, ._windowRank))
    else
      ([.groups[]?.buckets[]?] | to_entries
        | map(.key as $i | {
            name:(.value | fam),
            rem:(.value.remainingFraction | clamp),
            reset:(.value.resetTime // null),
            desc:(.value.description // null),
            idx:$i
          })) as $rows
      | ($rows
          | group_by(.name)
          | map({
              name: .[0].name,
              rem: (map(.rem) | min),
              reset:(map(.reset | select(. != null)) | sort | first // null),
              desc: (map(.desc | select(. != null)) | first // null),
              idx: (map(.idx) | min)
            })
          | sort_by([.rem, .idx])) as $fams
      | ($fams | map({
          name: .name,
          usedPercent: (((1 - .rem) * 10000 | round) / 100),
          windowMinutes: null,
          resetsAt: .reset,
          resetDescription: .name,
          description: .desc,
          displayValue: (((1 - .rem) * 100 | round | tostring) + "% used")
        }))
    end) as $windows
    | {
        install: $install,
        email: $email,
        loginMethod: $login,
        groupDescription: (.groups[0].description // .description // null),
        windows: $windows,
        updatedAt: (now | todateiso8601)
      }'
}

# Map fetchAvailableModels (the endpoint used by the desktop client) to an
# account. QuotaInfo lives on each ClientModelConfig rather than in the legacy
# retrieveUserQuotaSummary groups/buckets structure.
antigravity_models_account_json() {
  jq -c --arg install "$1" --arg email "$2" --arg login "$3" '
    def clamp: if type != "number" then 0 elif . < 0 then 0 elif . > 1 then 1 else . end;
    def family($id; $name):
      ($id + " " + $name | ascii_downcase) as $value
      | if ($value | test("gemini")) then {name:"Gemini Models", rank:0}
        elif ($value | test("claude|openai|chatgpt|codex|gpt|(^|[^a-z])o[134]([^a-z]|$)|oss")) then
          {name:"Claude & OpenAI Models", rank:1}
        else {name:"Other Models", rank:2}
        end;
    def window:
      {
        name:.name,
        usedPercent:(((1 - .rem) * 10000 | round) / 100),
        windowMinutes:null,
        resetsAt:.reset,
        resetDescription:.name,
        description:.desc,
        displayValue:(((1 - .rem) * 100 | round | tostring) + "% used")
      };
    # fetchAvailableModels is model-granular. The Antigravity UI, however,
    # exposes shared Gemini and Claude/OpenAI pools. Keep modelWindows for an
    # optional advanced view, while windows provides the concise family view.
    ([.models | to_entries[]? | .key as $id | .value
      | select(.quotaInfo != null)
      | (.displayName // .model // $id) as $name
      | select((($id + " " + $name) | ascii_downcase | test("placeholder")) | not)
      | (family($id; $name)) as $family
      | {
          name:$name,
          family:$family.name,
          familyRank:$family.rank,
          rem:(.quotaInfo.remainingFraction | clamp),
          reset:(.quotaInfo.resetTime // null),
          desc:(.tagDescription // .description // null)
        }]
      | sort_by([.familyRank, .name])) as $models
    | ($models
      | group_by(.family)
      | map(
          . as $members
          | ($members | sort_by([.rem, .name]) | .[0]) as $tightest
          | {
              name:$tightest.family,
              rank:$tightest.familyRank,
              rem:$tightest.rem,
              reset:$tightest.reset,
              desc:null
            }
        )
      | sort_by([.rem, .rank])) as $families
    | {
        install:$install,
        email:$email,
        loginMethod:$login,
        groupDescription:"Antigravity quota families",
        windows:($families | map(window)),
        modelWindows:($models | map(window)),
        updatedAt:(now | todateiso8601)
      }'
}

# AiOverviewControl follows the same sequence used by Antigravity: load the account's
# Cloud Code Assist project first, then pass its string ID to the preferred quota
# method (with fetchAvailableModels as compatibility fallback). An empty project
# can select a generic entitlement view instead of the IDE subscription.
# Print a compact JSON request body on success. On failure, print
# "code<TAB>message" to stderr and return non-zero.
antigravity_quota_request_body() {
  local access_token="$1" endpoint="$2" user_agent="$3" platform="$4"
  local tmp_body project http_status message
  tmp_body="$(mktemp)"
  : > "$tmp_body"

  if ! http_status="$(curl -sS --max-time 10 \
      --config <(printf 'header = "Authorization: Bearer %s"\n' "$access_token") \
      -o "$tmp_body" -w '%{http_code}' \
      -X POST \
      -H "Content-Type: application/json" \
      -H "User-Agent: ${user_agent}" \
      -H "X-Goog-Api-Client: google-cloud-sdk vscode_cloudshelleditor/0.1" \
      -d "{\"metadata\":{\"ideType\":9,\"platform\":${platform},\"pluginType\":2},\"mode\":1}" \
      "${endpoint}/v1internal:loadCodeAssist" 2>/dev/null)"; then
    rm -f "$tmp_body"
    printf '1\tAntigravity loadCodeAssist request could not reach Google.\n' >&2
    return 1
  fi
  if [ "$http_status" != "200" ]; then
    message="$(jq -r '.error.message // .message // empty' "$tmp_body" 2>/dev/null || true)"
    case "$http_status" in
      401|403) message="Antigravity session expired during loadCodeAssist. Open Antigravity and sign in again." ;;
      429) message="Antigravity loadCodeAssist endpoint is rate-limited. Retry later." ;;
      *) [ -n "$message" ] || message="Antigravity loadCodeAssist returned HTTP ${http_status:-0}." ;;
    esac
    rm -f "$tmp_body"
    printf '%s\t%s\n' "${http_status:-1}" "$message" >&2
    return 1
  fi
  project="$(jq -r '
    (.cloudaicompanionProject // empty)
    | if type == "string" then . elif type == "object" then (.id // empty) else empty end
  ' "$tmp_body" 2>/dev/null || true)"
  rm -f "$tmp_body"

  if [ -n "${project:-}" ] && [ "$project" != "null" ]; then
    jq -cn --arg project "$project" '{project:$project}'
  else
    printf '1\tAntigravity loadCodeAssist response schema changed: cloudaicompanionProject is missing; quota fetch was skipped to avoid a false 0%% result.\n' >&2
    return 1
  fi
}

antigravity_append_account_error() {
  local file="$1" install="$2" email="$3" stage="$4" code="$5" message="$6"
  case "$code" in ''|*[!0-9]*) code=1 ;; esac
  [ "$code" -gt 0 ] 2>/dev/null || code=1
  jq -cn \
    --arg install "$install" --arg email "$email" --arg stage "$stage" \
    --arg message "$message" --argjson code "$((10#$code))" \
    '{install:$install,email:$email,stage:$stage,code:$code,kind:"provider",message:$message}' >> "$file"
}

antigravity_http_error_message() {
  local stage="$1" status="$2" body="$3" message
  message="$(jq -r '.error.message // .message // empty' "$body" 2>/dev/null || true)"
  case "$status" in
    401|403) printf 'Antigravity session expired during %s. Open Antigravity and sign in again.' "$stage" ;;
    429) printf 'Antigravity %s endpoint is rate-limited. Retry later.' "$stage" ;;
    *) [ -n "$message" ] && printf '%s' "$message" || printf 'Antigravity %s returned HTTP %s.' "$stage" "${status:-0}" ;;
  esac
}

antigravity_append_group_account() {
  local accounts_file="$1" body_file="$2" install="$3" email="$4" login="$5" parsed
  parsed="$(antigravity_account_json "$install" "$email" "$login" < "$body_file")" || return 1
  printf '%s' "$parsed" | jq -e '(.windows | type) == "array" and (.windows | length) > 0' >/dev/null 2>&1 || return 1
  printf '%s\n' "$parsed" >> "$accounts_file"
}

antigravity_append_models_account() {
  local accounts_file="$1" body_file="$2" install="$3" email="$4" login="$5" parsed
  parsed="$(antigravity_models_account_json "$install" "$email" "$login" < "$body_file")" || return 1
  printf '%s' "$parsed" | jq -e '(.windows | type) == "array" and (.windows | length) > 0' >/dev/null 2>&1 || return 1
  printf '%s\n' "$parsed" >> "$accounts_file"
}

antigravity_fetch_account() {
  local accounts_file="$1" errors_file="$2" body_file="$3" install="$4" email="$5" login="$6"
  local access_token="$7" endpoint="$8" quota_body="$9" user_agent="${10}" preferred_method="${11}"
  local method status curl_status=0 message="" final_stage="$preferred_method"
  local -a methods=("$preferred_method")
  [ "$preferred_method" = "v1internal:fetchAvailableModels" ] || methods+=("v1internal:fetchAvailableModels")

  for method in "${methods[@]}"; do
    final_stage="$method"
    : > "$body_file"
    curl_status=0
    status="$(curl -sS --max-time 12 \
        --config <(printf 'header = "Authorization: Bearer %s"\n' "$access_token") \
        -o "$body_file" -w '%{http_code}' -X POST \
        -H "Content-Type: application/json" \
        -H "User-Agent: ${user_agent}" \
        -H "X-Client-Name: antigravity" \
        -H "X-Client-Version: 2.1.1" \
        -H "X-Goog-Api-Client: google-cloud-sdk vscode_cloudshelleditor/0.1" \
        -d "$quota_body" \
        "$endpoint/$method" 2>/dev/null)" || curl_status=$?

    if [ "$curl_status" -ne 0 ]; then
      message="Antigravity $method request could not reach Google."
      break
    fi
    if [ "$status" != "200" ]; then
      message="$(antigravity_http_error_message "$method" "$status" "$body_file")"
      case "$status" in 401|403|429) break ;; esac
      continue
    fi
    if jq -e '(.groups | type) == "array"' "$body_file" >/dev/null 2>&1 \
        && antigravity_append_group_account "$accounts_file" "$body_file" "$install" "$email" "$login"; then
      return 0
    fi
    if jq -e '(.models | type) == "object"' "$body_file" >/dev/null 2>&1 \
        && antigravity_append_models_account "$accounts_file" "$body_file" "$install" "$email" "$login"; then
      return 0
    fi
    status=1
    message="Antigravity $method response has no readable quota windows."
  done

  antigravity_append_account_error "$errors_file" "$install" "$email" "$final_stage" "${status:-1}" \
    "${message:-Antigravity quota response schema changed.}"
  return 1
}






