  printf '%s' "${base%/}"
}

# Compact JSON for the preferred Grok CLI login, or empty. Keep expired OIDC
# entries because the official CLI can renew them with the stored refresh token.
# Prefers SuperGrok OIDC entries (https://auth.x.ai::…) over the legacy
# accounts.x.ai session. Never prints the bearer token to stderr.
xai_grok_auth_json() {
  local auth_file
  auth_file="$(xai_grok_home)/auth.json"
  [ -r "$auth_file" ] || return 0
  jq -c '
    to_entries
    | map(select((.value.key | type) == "string" and (.value.key | length) > 0))
    | sort_by(if (.key | startswith("https://auth.x.ai")) then 0 else 1 end)
    | .[0].value // empty
  ' "$auth_file" 2>/dev/null || true
}

xai_grok_auth_is_expired() {
  local auth_json="$1"
  printf '%s' "$auth_json" | jq -e '
    def parse_ts($s):
      if ($s | type) != "string" or $s == "" then 0
      else ($s | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | try fromdateiso8601 catch 0)
      end;
    (.expires_at // "") as $expiry
    | $expiry != ""
      and (parse_ts($expiry) as $ts | $ts != 0 and $ts <= now)
  ' >/dev/null 2>&1
}

xai_grok_auth_has_refresh_token() {
  local auth_json="$1"
  printf '%s' "$auth_json" \
    | jq -e '(.refresh_token | type) == "string" and (.refresh_token | length) > 0' \
      >/dev/null 2>&1
}

xai_grok_cli_path() {
  local grok_home candidate
  if command -v grok >/dev/null 2>&1; then
    command -v grok
    return 0
  fi
  grok_home="$(xai_grok_home)"
  for candidate in "$grok_home/bin/grok" "$HOME/.grok/bin/grok" "$HOME/.local/bin/grok"; do
    if [ -x "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

# Renewal attempts are stamped here so repeated polls with a token the CLI
# cannot renew do not spawn one `grok` process per poll. The widget polls far
# more often than a token expires, and a failing renewal fails the same way
# every time (issue #25 taught us this for the Codex app-server).
xai_refresh_stamp_file() {
  printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/AiOverviewControl/xai-grok-refresh"
}

xai_refresh_in_cooldown() {
  local stamp_file last now
  stamp_file="$(xai_refresh_stamp_file)"
  [ -f "$stamp_file" ] || return 1
  last="$(cat "$stamp_file" 2>/dev/null || printf '')"
  case "$last" in '' | *[!0-9]*) return 1 ;; esac
  now="$(date +%s)"
  [ "$((now - last))" -ge 0 ] && [ "$((now - last))" -lt "${XAI_REFRESH_COOLDOWN:-300}" ]
}

# Stamp before launching, not after: two polls that overlap must not both
# decide the coast is clear.
xai_mark_refresh_attempt() {
  local stamp_file
  stamp_file="$(xai_refresh_stamp_file)"
  mkdir -p "${stamp_file%/*}" 2>/dev/null || return 0
  date +%s >"$stamp_file" 2>/dev/null || true
}

xai_clear_refresh_attempt() {
  rm -f "$(xai_refresh_stamp_file)" 2>/dev/null || true
}

# Let Grok own OIDC refresh-token rotation and auth.json locking. `grok models`
# is read-only account metadata, but it initializes the same authenticated
# client as an agent session and silently renews an expired access token.
xai_refresh_grok_auth() {
  local previous_auth="${1:-}" grok_cli
  xai_refresh_in_cooldown && return 1
  grok_cli="$(xai_grok_cli_path)" || return 1
  xai_mark_refresh_attempt
  timeout 10 "$grok_cli" models >/dev/null 2>&1 </dev/null || true

  local refreshed previous_fingerprint refreshed_fingerprint
  refreshed="$(xai_grok_auth_json)"
  [ -n "$refreshed" ] && ! xai_grok_auth_is_expired "$refreshed" || return 1
  if [ -z "$previous_auth" ]; then
    xai_clear_refresh_attempt
    return 0
  fi

  previous_fingerprint="$(printf '%s' "$previous_auth" | jq -c '[.key, .refresh_token, .expires_at]' 2>/dev/null || true)"
  refreshed_fingerprint="$(printf '%s' "$refreshed" | jq -c '[.key, .refresh_token, .expires_at]' 2>/dev/null || true)"
  [ -n "$refreshed_fingerprint" ] && [ "$refreshed_fingerprint" != "$previous_fingerprint" ] || return 1
  # A renewal that worked clears the cooldown: the next expiry is legitimate
  # and should be renewable immediately.
  xai_clear_refresh_attempt
}

xai_grok_has_auth_file() {
  local auth_file
  auth_file="$(xai_grok_home)/auth.json"
  [ -r "$auth_file" ] \
    && jq -e 'to_entries | any((.value.key | type) == "string" and (.value.key | length) > 0)' \
      "$auth_file" >/dev/null 2>&1
}

