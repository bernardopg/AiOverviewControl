#!/usr/bin/env bash
set -uo pipefail

PROVIDERS_CSV="${1:-codex,claude,copilot}"
COPILOT_SCRIPT="${2:-}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -n "$COPILOT_SCRIPT" ] || COPILOT_SCRIPT="$SCRIPT_DIR/get-copilot-usage"
CLAUDE_SCRIPT="$SCRIPT_DIR/get-claude-usage"
CODEX_SCRIPT="$SCRIPT_DIR/get-codex-usage"

# Per-run scratch dir so every mktemp below is cleaned up on exit, even when
# a fetch dies mid-flight (timeout, signal, jq error) before its manual rm.
_RUN_TMPDIR="$(mktemp -d)"
trap 'rm -rf "$_RUN_TMPDIR"' EXIT
export TMPDIR="$_RUN_TMPDIR"

json_error() {
  local provider="$1"
  local source="$2"
  local code="$3"
  local kind="$4"
  local message="$5"
  case "$code" in
    ""|*[!0-9]*) code=1 ;;
  esac
  code="$((10#$code))"
  [ "$code" -gt 0 ] 2>/dev/null || code=1
  jq -cn \
    --arg provider "$provider" \
    --arg source "$source" \
    --arg kind "$kind" \
    --arg message "$message" \
    --argjson code "${code:-1}" \
    '{provider:$provider,source:$source,error:{code:$code,kind:$kind,message:$message}}'
}

json_note_usage() {
  local provider="$1"
  local source="$2"
  local account="$3"
  local login="$4"
  local label="$5"
  local credits="${6:-unknown}"
  jq -cn \
    --arg provider "$provider" \
    --arg source "$source" \
    --arg account "$account" \
    --arg login "$login" \
    --arg label "$label" \
    --arg credits "$credits" \
    '{
      provider:$provider,
      source:$source,
      usage:{
        identity:{providerID:$provider,accountEmail:$account,loginMethod:$login},
        accountEmail:$account,
        loginMethod:$login,
        primary:{usedPercent:0,windowMinutes:null,resetsAt:null,resetDescription:$label},
        secondary:null,
        tertiary:null,
        updatedAt:(now|todateiso8601)
      },
      credits:{remaining:$credits}
    }'
}

fetch_copilot() {
  if [ -x "$COPILOT_SCRIPT" ]; then
    local tmp_out tmp_err status message
    tmp_out="$(mktemp)"
    tmp_err="$(mktemp)"
    "$COPILOT_SCRIPT" >"$tmp_out" 2>"$tmp_err"
    status=$?

    if [ -s "$tmp_out" ] && jq -e . "$tmp_out" >/dev/null 2>&1; then
      cat "$tmp_out"
      rm -f "$tmp_out" "$tmp_err"
      return 0
    fi

    message="$(cat "$tmp_err" 2>/dev/null || true)"
    [ -n "$message" ] || message="GitHub Copilot usage helper returned invalid output."
    rm -f "$tmp_out" "$tmp_err"

    json_error copilot github-copilot-api "${status:-1}" runtime "$message"
    return 0
  fi
  json_error copilot github-copilot-api 127 runtime "Copilot helper script is missing or not executable."
}

