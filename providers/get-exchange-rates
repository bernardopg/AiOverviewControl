#!/usr/bin/env bash
# Display-only USD conversion. Never receives provider credentials or costs.
set -euo pipefail
CURRENCY="${1:-USD}"
case "$CURRENCY" in
    USD) printf '{"base":"USD","currency":"USD","rate":1,"stale":false}\n'; exit 0 ;;
    EUR|BRL|GBP|CAD|CNY|JPY|AUD|CHF) ;;
    *) printf '{"error":"unsupported_currency"}\n'; exit 0 ;;
esac
error() { printf '{"error":"exchange_rate_unavailable"}\n'; }
command -v jq >/dev/null || { error; exit 0; }
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/AiOverviewControl"
CACHE="$CACHE_DIR/exchange-rate-$CURRENCY.json"
NOW="$(date +%s)"
MAX_AGE=604800
valid() {
    jq -e --arg currency "$CURRENCY" --argjson now "$NOW" --argjson age "$1" '
        .base == "USD" and .currency == $currency and
        (.rate | type == "number" and . > 0 and . < 1000000) and
        (.date | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) and
        (.fetchedAt | type == "number" and . <= $now and . > ($now - $age))
    ' "$CACHE" >/dev/null 2>&1
}
emit_cached() { jq --argjson stale "$1" '. + {stale: $stale}' "$CACHE"; }
if valid 86400; then emit_cached false; exit 0; fi
# Opt-out also prevents refreshing an expired cache; cached data stays display-only.
if [[ "${AIOC_NO_FX:-0}" == 1 ]] || ! command -v curl >/dev/null; then
    if valid "$MAX_AGE"; then emit_cached true; else error; fi
    exit 0
fi
if ! mkdir -p "$CACHE_DIR" || ! chmod 700 "$CACHE_DIR"; then error; exit 0; fi
umask 077
if ! command -v flock >/dev/null; then error; exit 0; fi
exec 9>"$CACHE.lock"
if ! flock -w 10 9; then
    if valid "$MAX_AGE"; then emit_cached true; else error; fi
    exit 0
fi
# Another reader may have refreshed while we waited for the lock.
if valid 86400; then emit_cached false; exit 0; fi
TMP="$(mktemp "$CACHE_DIR/.exchange-rate.XXXXXX")"
trap 'rm -f "$TMP"' EXIT
# -q prevents an unrelated ~/.curlrc from adding headers/credentials to this host.
if curl -qfsSL --proto '=https' --proto-redir '=https' --connect-timeout 3 --max-time 8 \
    "https://api.frankfurter.dev/v1/latest?base=USD&symbols=$CURRENCY" \
    | jq -e --arg currency "$CURRENCY" --argjson now "$NOW" '
        select(.base == "USD") |
        select(.date | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) |
        .rates[$currency] as $rate |
        select($rate | type == "number" and . > 0 and . < 1000000) |
        {base: "USD", currency: $currency, rate: $rate, date: .date,
         fetchedAt: $now, stale: false}
    ' > "$TMP" 2>/dev/null && [[ -s "$TMP" ]]; then
    mv -f "$TMP" "$CACHE"
    emit_cached false
elif valid "$MAX_AGE"; then
    emit_cached true
else
    error
fi
