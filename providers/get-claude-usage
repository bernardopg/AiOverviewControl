#!/usr/bin/env bash
set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CREDENTIALS="${CLAUDE_DIR}/.credentials.json"
# stats-cache.json is Claude Code's own file — read-only from here, never written.
STATS_CACHE="${CLAUDE_DIR}/stats-cache.json"
PROJECTS_DIR="${CLAUDE_DIR}/projects"
# Plugin-owned caches live in the XDG cache dir alongside every other adapter,
# never inside another tool's config directory.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/AiOverviewControl"
PRICING_CACHE="${CACHE_DIR}/claude-pricing-cache.json"
USAGE_CACHE="${CACHE_DIR}/claude-usage-cache.json"
TRANSCRIPTS_CACHE="${CACHE_DIR}/claude-transcripts.tsv"
VERSION_CACHE="${CACHE_DIR}/claude-version-cache.json"
USAGE_CACHE_TTL=120  # seconds
VERSION_CACHE_TTL=86400  # seconds: the CLI version changes on upgrade, not per refresh
LITELLM_URL="https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"

mkdir -p "$CACHE_DIR"
# One-time migration: these caches used to be written into ~/.claude. Move the
# data across so the refreshed paths stay warm, then leave no trace behind.
for legacy in pricing-cache usage-cache; do
    if [ -f "${CLAUDE_DIR}/${legacy}.json" ]; then
        mv "${CLAUDE_DIR}/${legacy}.json" "${CACHE_DIR}/claude-${legacy}.json" 2>/dev/null \
            || rm -f "${CLAUDE_DIR}/${legacy}.json"
    fi
done
# 1.17.2 kept a whole-aggregate cache here; per-transcript rows replace it.
rm -f "${CACHE_DIR}/claude-local-stats.json"

# The CLI version only matters for the User-Agent header; probe it at most
# once a day instead of spawning `claude --version` on every refresh.
CLAUDE_VERSION=""
if [ -f "$VERSION_CACHE" ]; then
    ver_ts=$(jq -r '.cached_at // 0' "$VERSION_CACHE" 2>/dev/null || echo 0)
    ver_val=$(jq -r '.version // ""' "$VERSION_CACHE" 2>/dev/null || echo "")
    if [ -n "$ver_val" ] && [ $(( $(date +%s) - ver_ts )) -lt "$VERSION_CACHE_TTL" ]; then
        CLAUDE_VERSION="$ver_val"
    fi
fi
if [ -z "$CLAUDE_VERSION" ]; then
    CLAUDE_VERSION=$(claude --version 2>/dev/null | head -1 | grep -oP '[\d.]+' || echo "2.0.0")
    jq -n --arg v "$CLAUDE_VERSION" '{cached_at: (now | floor), version: $v}' > "$VERSION_CACHE" 2>/dev/null || true
fi
TODAY=$(date +%Y-%m-%d)
# Calendar week: Monday to Sunday
DOW=$(date +%u)  # 1=Monday, 7=Sunday
WEEK_START=$(date -d "$((DOW - 1)) days ago" +%Y-%m-%d)
# Calendar month: 1st of current month
MONTH_START=$(date +%Y-%m-01)

# Defaults
SUBSCRIPTION_TYPE="unknown"
RATE_LIMIT_TIER="unknown"
FIVE_HOUR_UTIL=0
FIVE_HOUR_RESET=""
SEVEN_DAY_UTIL=0
SEVEN_DAY_RESET=""
SCOPED_LIMIT_UTIL=0
SCOPED_LIMIT_RESET=""
SCOPED_LIMIT_MODEL=""
SCOPED_LIMIT_ACTIVE="false"
EXTRA_USAGE_ENABLED="false"
EXTRA_USAGE_UTIL=0
EXTRA_USAGE_USED=0
EXTRA_USAGE_LIMIT=0
EXTRA_USAGE_CURRENCY=""
EXTRA_USAGE_DECIMALS=2
API_RESPONSE='{}'
USAGE_ERROR_KIND=""
USAGE_ERROR_MESSAGE=""

WEEK_TOKENS=0
WEEK_MESSAGES=0
WEEK_SESSIONS=0
MONTH_TOKENS=0
WEEK_MODELS=""
WEEK_MODEL_COSTS=""
WEEK_PROJECTS=""
DAILY="0,0,0,0,0,0,0"

TODAY_COST="0.00"
WEEK_COST="0.00"
MONTH_COST="0.00"
DAILY_COSTS="0,0,0,0,0,0,0"

ALLTIME_SESSIONS=0
ALLTIME_MESSAGES=0
FIRST_SESSION="unknown"

# --- Pricing cache (refresh once per day from LiteLLM) ---
# LiteLLM's pricing table is third-party data fetched from
# raw.githubusercontent.com; AIOC_NO_LITELLM=1 opts out (cost fields then fall
# back to the last cached snapshot, or 0.00 when no snapshot exists).
PRICING_JSON=""
refresh_pricing() {
    [ "${AIOC_NO_LITELLM:-0}" = "1" ] && return 1
    local raw
    raw=$(curl -s --max-time 10 "$LITELLM_URL" 2>/dev/null) || return 1
    # Dynamically extract pricing for all Claude model families
    # Pattern: "claude-{family}-{major}[-{minor}]" (no date suffix, no provider
    # prefix). Single-number versions (e.g. claude-fable-5) must match too,
    # otherwise whole families silently price at $0.
    # Groups by family name, takes the latest version per family
    local result
    result=$(echo "$raw" | jq -c '{
        schema: 2,
        updated: "'"$TODAY"'",
        models: ([to_entries[]
            | select(.key | test("^claude-[a-z]+-[0-9]+(-[0-9]+)?$"))
            | select(.value.input_cost_per_token > 0)
            | {
                family: (.key | split("-") | .[1]),
                key: .key,
                value: .value
              }
        ] | group_by(.family)
          | map(sort_by(.key) | last
              | {key: .family, value: {
                    input: .value.input_cost_per_token,
                    output: .value.output_cost_per_token,
                    cache_read: .value.cache_read_input_token_cost,
                    cache_write: .value.cache_creation_input_token_cost
                }})
          | from_entries)
    }' 2>/dev/null) || return 1

    # Validate that we got at least one model with pricing
    local check
    check=$(echo "$result" | jq -r '.models | to_entries | length' 2>/dev/null) || return 1
    [ "$check" -gt 0 ] 2>/dev/null && echo "$result" > "$PRICING_CACHE" && return 0
    return 1
}

if [ -f "$PRICING_CACHE" ]; then
    cached_date=$(jq -r '.updated // ""' "$PRICING_CACHE" 2>/dev/null || echo "")
    cached_schema=$(jq -r '.schema // 0' "$PRICING_CACHE" 2>/dev/null || echo 0)
    if [ "$cached_date" != "$TODAY" ] || [ "$cached_schema" != "2" ]; then
        refresh_pricing || true
    fi
    PRICING_JSON=$(cat "$PRICING_CACHE")
else
    refresh_pricing || true
    [ -f "$PRICING_CACHE" ] && PRICING_JSON=$(cat "$PRICING_CACHE")
fi

# Build awk-friendly pricing string: "opus:input:output:cache_read:cache_write,sonnet:...,haiku:..."
PRICING_AWK=""
if [ -n "$PRICING_JSON" ]; then
    PRICING_AWK=$(echo "$PRICING_JSON" | jq -r '
        [.models | to_entries[] | "\(.key):\(.value.input):\(.value.output):\(.value.cache_read):\(.value.cache_write)"]
        | join(",")' 2>/dev/null || echo "")
fi

# --- Subscription & API Usage (with a short cache to avoid rate limits) ---
if [ -f "$CREDENTIALS" ]; then
    SUBSCRIPTION_TYPE=$(jq -r '.claudeAiOauth.subscriptionType // "unknown"' "$CREDENTIALS")
    RATE_LIMIT_TIER=$(jq -r '.claudeAiOauth.rateLimitTier // "unknown"' "$CREDENTIALS")

    # Check if cached usage data is still fresh
    USE_CACHE=false
    if [ -f "$USAGE_CACHE" ]; then
        cache_ts=$(jq -r '.cached_at // 0' "$USAGE_CACHE" 2>/dev/null || echo 0)
        now_ts=$(date +%s)
        age=$(( now_ts - cache_ts ))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$USAGE_CACHE_TTL" ] \
            && jq -e '.data.five_hour | type == "object"' "$USAGE_CACHE" >/dev/null 2>&1; then
            USE_CACHE=true
        fi
    fi

    if [ "$USE_CACHE" = true ]; then
        API_RESPONSE=$(jq -r '.data' "$USAGE_CACHE" 2>/dev/null || echo '{}')
    else
        TOKEN=$(jq -r '.claudeAiOauth.accessToken // ""' "$CREDENTIALS")
        if [ -n "$TOKEN" ]; then
            usage_body=$(mktemp)
            usage_status=$(curl -sS --max-time 8 -o "$usage_body" -w '%{http_code}' \
                -H "Authorization: Bearer ${TOKEN}" \
                -H "Accept: application/json" \
                -H "Content-Type: application/json" \
                -H "User-Agent: claude-code/${CLAUDE_VERSION}" \
                -H "anthropic-beta: oauth-2025-04-20" \
                "https://api.anthropic.com/api/oauth/usage" 2>/dev/null || true)

            if [ "$usage_status" = "200" ] \
                && jq -e '.five_hour | type == "object"' "$usage_body" >/dev/null 2>&1; then
                API_RESPONSE=$(cat "$usage_body")
                jq -n --argjson data "$API_RESPONSE" '{cached_at: (now | floor), data: $data}' > "$USAGE_CACHE" 2>/dev/null
            elif [ "$usage_status" = "401" ] || [ "$usage_status" = "403" ]; then
                # Credentials are genuinely invalid — stale data would mislead.
                USAGE_ERROR_KIND="authentication"
                USAGE_ERROR_MESSAGE="Claude OAuth credentials are invalid or expired. Run: claude auth login --claudeai"
            elif jq -e '.data.five_hour | type == "object"' "$USAGE_CACHE" >/dev/null 2>&1; then
                # Transient failure (429, 5xx, network): fall back to the last
                # good snapshot even past its TTL instead of erroring the card.
                API_RESPONSE=$(jq -r '.data' "$USAGE_CACHE" 2>/dev/null || echo '{}')
            else
                USAGE_ERROR_KIND="network"
                USAGE_ERROR_MESSAGE="Claude usage request failed with HTTP ${usage_status:-unknown}."
            fi
            rm -f "$usage_body"
        else
            USAGE_ERROR_KIND="authentication"
            USAGE_ERROR_MESSAGE="Claude OAuth access token is missing. Run: claude auth login --claudeai"
        fi
    fi

    # The Claude 5 rollout added a canonical `limits[]` array (kind: session /
    # weekly_all / weekly_scoped). Prefer it when present; the flat five_hour /
    # seven_day objects remain as fallback for older API responses.
    FIVE_HOUR_UTIL=$(echo "$API_RESPONSE" | jq -r '([.limits[]? | select(.kind == "session")] | .[0].percent) // .five_hour.utilization // 0')
    FIVE_HOUR_RESET=$(echo "$API_RESPONSE" | jq -r '([.limits[]? | select(.kind == "session")] | .[0].resets_at) // .five_hour.resets_at // ""')
    SEVEN_DAY_UTIL=$(echo "$API_RESPONSE" | jq -r '([.limits[]? | select(.kind == "weekly_all")] | .[0].percent) // .seven_day.utilization // 0')
    SEVEN_DAY_RESET=$(echo "$API_RESPONSE" | jq -r '([.limits[]? | select(.kind == "weekly_all")] | .[0].resets_at) // .seven_day.resets_at // ""')

    # Model-scoped weekly window (e.g. weekly Fable allowance on Pro/Max).
    # Active scopes sort first so the binding limit wins when several exist.
    SCOPED_QUERY='[.limits[]? | select(.kind == "weekly_scoped" and (.scope.model.display_name // "") != "")] | sort_by(if .is_active then 0 else 1 end)'
    SCOPED_LIMIT_UTIL=$(echo "$API_RESPONSE" | jq -r "${SCOPED_QUERY} | .[0].percent // 0")
    SCOPED_LIMIT_RESET=$(echo "$API_RESPONSE" | jq -r "${SCOPED_QUERY} | .[0].resets_at // \"\"")
    SCOPED_LIMIT_MODEL=$(echo "$API_RESPONSE" | jq -r "${SCOPED_QUERY} | .[0].scope.model.display_name // \"\"")
    SCOPED_LIMIT_ACTIVE=$(echo "$API_RESPONSE" | jq -r "${SCOPED_QUERY} | .[0].is_active // false")

    EXTRA_USAGE_ENABLED=$(echo "$API_RESPONSE" | jq -r '.extra_usage.is_enabled // false')
    EXTRA_USAGE_UTIL=$(echo "$API_RESPONSE" | jq -r '.extra_usage.utilization // 0')
    EXTRA_USAGE_USED=$(echo "$API_RESPONSE" | jq -r '.extra_usage.used_credits // 0')
    EXTRA_USAGE_LIMIT=$(echo "$API_RESPONSE" | jq -r '.extra_usage.monthly_limit // 0')
    EXTRA_USAGE_CURRENCY=$(echo "$API_RESPONSE" | jq -r '.extra_usage.currency // ""')
    EXTRA_USAGE_DECIMALS=$(echo "$API_RESPONSE" | jq -r '.extra_usage.decimal_places // 2')
else
    USAGE_ERROR_KIND="authentication"
    USAGE_ERROR_MESSAGE="Claude credentials were not found. Run: claude auth login --claudeai"
fi

# --- Token consumption from JSONL session files ---
# Per-transcript extraction cache: jq parses each session file once per
# (size, mtime) and its assistant-message rows are kept in
# claude-transcripts.tsv. A refresh re-parses only files that changed —
# normally just the active session — and awk aggregates the cached rows.
# Rows carry the local date, so a UTC-offset change rebuilds the cache.
# ponytail: a changed file is re-parsed whole; parse from the previous size
# if long active sessions ever make that slow.
if [ -d "$PROJECTS_DIR" ]; then
    TX_HEADER="#aioc-claude-transcripts v1 $(date +%z)"
    TX_NEW=$(mktemp "${TRANSCRIPTS_CACHE}.XXXXXX")
    TX_CURRENT=$(find "$PROJECTS_DIR" -name "*.jsonl" -mtime -31 -printf '%P\t%s:%T@\n' 2>/dev/null || true)

    echo "$TX_HEADER" > "$TX_NEW"
    if [ -f "$TRANSCRIPTS_CACHE" ] && [ "$(head -n 1 "$TRANSCRIPTS_CACHE")" = "$TX_HEADER" ]; then
        # Keep rows whose file is still in the window with an unchanged stamp.
        tail -n +2 "$TRANSCRIPTS_CACHE" \
            | awk -F'\t' 'NR == FNR { cur[$1] = $2; next } ($1 in cur) && cur[$1] == $2' \
                <(printf '%s\n' "$TX_CURRENT") - >> "$TX_NEW" || true
    fi

    # Stale = in the window but without any kept row (every parsed file leaves
    # at least a "#" sentinel row, so empty transcripts are not re-parsed).
    # Unreadable files are skipped, not cached, so they are retried later.
    TX_STALE=$(awk -F'\t' 'NR == FNR { if (FNR > 1) kept[$1 FS $2] = 1; next }
            $1 != "" && !(($1 FS $2) in kept) { print $1 FS $2 }' "$TX_NEW" <(printf '%s\n' "$TX_CURRENT") \
        | while IFS=$'\t' read -r path stamp; do
            [ -r "${PROJECTS_DIR}/${path}" ] && printf '%s\t%s\n' "$path" "$stamp"
        done || true)

    # Paths get a "./" prefix: Claude project dirs start with "-", which
    # jq would otherwise parse as options.
    # Rows: path, stamp, local date, model, in, out, cache read, cache write, session, cwd.
    # Timestamps in session JSONL are UTC; convert to the local day so
    # buckets line up with WEEK_START/TODAY — raw UTC prefix as fallback.
    # Rows (and the "#" sentinels) are only cached when every jq call
    # succeeded; a failed batch is dropped and retried on the next refresh.
    if [ -n "$TX_STALE" ] && TX_ROWS=$(cd "$PROJECTS_DIR" \
        && printf '%s\n' "$TX_STALE" | cut -f1 | sed 's|^|./|' | xargs -r -d '\n' jq -r -R '
            fromjson? | select(.type == "assistant" and (.timestamp | type == "string") and (.message.model? != "<synthetic>"))
            | ((.timestamp | sub("\\.[0-9]+"; "") | fromdateiso8601?) // null) as $ts
            | (if $ts != null then ($ts | strflocaltime("%Y-%m-%d")) else .timestamp[:10] end) as $date
            | [(input_filename | ltrimstr("./")), $date, (.message.model // "unknown"),
               (.message.usage.input_tokens // 0), (.message.usage.output_tokens // 0),
               (.message.usage.cache_read_input_tokens // 0), (.message.usage.cache_creation_input_tokens // 0),
               (.sessionId // "unknown"), ((.cwd // "unknown") | gsub("[,:\t]"; "_"))] | @tsv' 2>/dev/null); then
        printf '%s\n' "$TX_ROWS" \
            | awk -F'\t' -v OFS='\t' 'NR == FNR { stamp[$1] = $2; print $1, $2, "#"; next }
                ($1 in stamp) { path = $1; $1 = ""; print path, stamp[path] $0 }' <(printf '%s\n' "$TX_STALE") - >> "$TX_NEW"
    fi
    mv "$TX_NEW" "$TRANSCRIPTS_CACHE" 2>/dev/null || rm -f "$TX_NEW"

    # Calendar week dates: Monday (index 1) to Sunday (index 7)
    DAY_DATES=""
    for i in $(seq 0 6); do
        d=$(date -d "$WEEK_START + ${i} days" +%Y-%m-%d)
        DAY_DATES="${DAY_DATES:+${DAY_DATES},}${d}"
    done

    while IFS='=' read -r key value; do
        case "$key" in
            WEEK_TOKENS) WEEK_TOKENS="$value" ;;
            WEEK_MESSAGES) WEEK_MESSAGES="$value" ;;
            WEEK_SESSIONS) WEEK_SESSIONS="$value" ;;
            WEEK_PROJECTS) WEEK_PROJECTS="$value" ;;
            MONTH_TOKENS) MONTH_TOKENS="$value" ;;
            DAILY) DAILY="$value" ;;
            WEEK_MODELS) WEEK_MODELS="$value" ;;
            WEEK_MODEL_COSTS) WEEK_MODEL_COSTS="$value" ;;
            TODAY_COST) TODAY_COST="$value" ;;
            WEEK_COST) WEEK_COST="$value" ;;
            MONTH_COST) MONTH_COST="$value" ;;
            DAILY_COSTS) DAILY_COSTS="$value" ;;
        esac
    done < <(tail -n +2 "$TRANSCRIPTS_CACHE" 2>/dev/null \
        | awk -F'\t' -v week_start="$WEEK_START" -v month_start="$MONTH_START" -v today="$TODAY" -v day_dates="$DAY_DATES" -v pricing="$PRICING_AWK" '
        BEGIN {
            split(day_dates, dates, ",")
            # Parse pricing: "opus:in:out:cr:cw,sonnet:in:out:cr:cw,haiku:in:out:cr:cw"
            has_pricing = 0
            if (pricing != "") {
                n = split(pricing, pmodels, ",")
                for (i = 1; i <= n; i++) {
                    split(pmodels[i], pp, ":")
                    price_in[pp[1]] = pp[2] + 0
                    price_out[pp[1]] = pp[3] + 0
                    price_cr[pp[1]] = pp[4] + 0
                    price_cw[pp[1]] = pp[5] + 0
                }
                has_pricing = 1
            }
        }
        $3 == "#" { next }
        {
            date = $3; model = $4
            inp = $5 + 0; out = $6 + 0; cr = $7 + 0; cw = $8 + 0
            sess = $9; proj = $10
            total = inp + out + cr + cw

            # Extract family from model name (claude-{family}-{version...})
            n_parts = split(model, mparts, "-")
            family = (n_parts >= 3 && mparts[1] == "claude") ? mparts[2] : model

            day[date] += total
            if (date >= week_start) {
                week_model[family] += total
                week_tokens += total
                week_msgs++
                week_sess[sess] = 1
                # Top projects: each session line carries its real working
                # directory in .cwd (commas/colons stripped for the CSV).
                week_proj[proj] += total
            }
            if (date >= month_start) month_tokens += total

            # Cost calculation
            if (has_pricing && (family in price_in)) {
                cost = inp * price_in[family] + out * price_out[family] + cr * price_cr[family] + cw * price_cw[family]
                day_cost[date] += cost
                if (date >= week_start) {
                    week_cost += cost
                    week_model_cost[family] += cost
                }
                if (date >= month_start) month_cost += cost
            }
        }
        END {
            printf "WEEK_TOKENS=%d\n", week_tokens + 0
            printf "WEEK_MESSAGES=%d\n", week_msgs + 0
            n = 0; for (s in week_sess) n++
            printf "WEEK_SESSIONS=%d\n", n
            printf "MONTH_TOKENS=%d\n", month_tokens + 0

            daily = ""
            for (i = 1; i <= 7; i++) {
                val = (dates[i] in day) ? day[dates[i]] : 0
                daily = daily (i > 1 ? "," : "") val + 0
            }
            printf "DAILY=%s\n", daily

            models = ""
            first = 1
            for (m in week_model) {
                if (week_model[m] > 0) {
                    models = models (first ? "" : ",") m ":" week_model[m]
                    first = 0
                }
            }
            printf "WEEK_MODELS=%s\n", models

            model_costs = ""
            first = 1
            for (m in week_model_cost) {
                if (week_model_cost[m] > 0) {
                    model_costs = model_costs (first ? "" : ",") m ":" sprintf("%.2f", week_model_cost[m])
                    first = 0
                }
            }
            printf "WEEK_MODEL_COSTS=%s\n", model_costs

            # Top 5 projects by tokens, descending
            projects = ""
            for (k = 1; k <= 5; k++) {
                best = ""
                for (p in week_proj) if (best == "" || week_proj[p] > week_proj[best]) best = p
                if (best == "") break
                projects = projects (k > 1 ? "," : "") best ":" sprintf("%d", week_proj[best])
                delete week_proj[best]
            }
            printf "WEEK_PROJECTS=%s\n", projects

            # Cost outputs
            daily_costs = ""
            for (i = 1; i <= 7; i++) {
                val = (dates[i] in day_cost) ? day_cost[dates[i]] : 0
                daily_costs = daily_costs (i > 1 ? "," : "") sprintf("%.2f", val)
            }
            printf "DAILY_COSTS=%s\n", daily_costs
            printf "TODAY_COST=%.2f\n", (today in day_cost) ? day_cost[today] : 0
            printf "WEEK_COST=%.2f\n", week_cost + 0
            printf "MONTH_COST=%.2f\n", month_cost + 0
        }')
fi

# --- All-time from stats cache (supplementary) ---
if [ -f "$STATS_CACHE" ]; then
    ALLTIME_SESSIONS=$(jq -r '.totalSessions // 0' "$STATS_CACHE" 2>/dev/null || echo 0)
    ALLTIME_MESSAGES=$(jq -r '.totalMessages // 0' "$STATS_CACHE" 2>/dev/null || echo 0)
    FIRST_SESSION=$(jq -r '.firstSessionDate // "unknown"' "$STATS_CACHE" 2>/dev/null || echo "unknown")
    FIRST_SESSION="${FIRST_SESSION%%T*}"
fi

# Output key=value pairs
echo "SUBSCRIPTION_TYPE=${SUBSCRIPTION_TYPE}"
echo "RATE_LIMIT_TIER=${RATE_LIMIT_TIER}"
echo "FIVE_HOUR_UTIL=${FIVE_HOUR_UTIL}"
echo "FIVE_HOUR_RESET=${FIVE_HOUR_RESET}"
echo "SEVEN_DAY_UTIL=${SEVEN_DAY_UTIL}"
echo "SEVEN_DAY_RESET=${SEVEN_DAY_RESET}"
echo "SCOPED_LIMIT_UTIL=${SCOPED_LIMIT_UTIL}"
echo "SCOPED_LIMIT_RESET=${SCOPED_LIMIT_RESET}"
echo "SCOPED_LIMIT_MODEL=${SCOPED_LIMIT_MODEL}"
echo "SCOPED_LIMIT_ACTIVE=${SCOPED_LIMIT_ACTIVE}"
echo "EXTRA_USAGE_ENABLED=${EXTRA_USAGE_ENABLED}"
echo "EXTRA_USAGE_UTIL=${EXTRA_USAGE_UTIL}"
echo "EXTRA_USAGE_USED=${EXTRA_USAGE_USED}"
echo "EXTRA_USAGE_LIMIT=${EXTRA_USAGE_LIMIT}"
echo "EXTRA_USAGE_CURRENCY=${EXTRA_USAGE_CURRENCY}"
echo "EXTRA_USAGE_DECIMALS=${EXTRA_USAGE_DECIMALS}"
echo "USAGE_ERROR_KIND=${USAGE_ERROR_KIND}"
echo "USAGE_ERROR_MESSAGE=${USAGE_ERROR_MESSAGE}"
echo "WEEK_MESSAGES=${WEEK_MESSAGES}"
echo "WEEK_SESSIONS=${WEEK_SESSIONS}"
echo "WEEK_TOKENS=${WEEK_TOKENS}"
echo "WEEK_MODELS=${WEEK_MODELS}"
echo "WEEK_MODEL_COSTS=${WEEK_MODEL_COSTS}"
echo "WEEK_PROJECTS=${WEEK_PROJECTS}"
echo "ALLTIME_SESSIONS=${ALLTIME_SESSIONS}"
echo "ALLTIME_MESSAGES=${ALLTIME_MESSAGES}"
echo "FIRST_SESSION=${FIRST_SESSION}"
echo "DAILY=${DAILY}"
echo "MONTH_TOKENS=${MONTH_TOKENS}"
echo "TODAY_COST=${TODAY_COST}"
echo "WEEK_COST=${WEEK_COST}"
echo "MONTH_COST=${MONTH_COST}"
echo "DAILY_COSTS=${DAILY_COSTS}"
