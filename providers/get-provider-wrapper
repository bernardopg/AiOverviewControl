#!/usr/bin/env bash
set -euo pipefail
# Caches, history and state hold account data: keep them owner-only.
umask 077

PROVIDER="${1:?provider id required}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COPILOT_SCRIPT="${COPILOT_SCRIPT:-$SCRIPT_DIR/get-copilot-usage}"

exec "$SCRIPT_DIR/get-provider-usage" "$PROVIDER" "$COPILOT_SCRIPT"
