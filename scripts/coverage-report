#!/usr/bin/env python3
"""Statement coverage from a kcov codecov.json, counting only shell statements.

kcov's bash parser marks every physical line as instrumentable, including the
body of a multi-line quoted string (an embedded jq, awk or Python program), a
heredoc body and a backslash-continued argument line. Those lines belong to
the statement that starts above them and are not separate statements. They are
grouped with that starting line, and a statement counts as covered when any
line in the group has hits. The elements of a multi-line array assignment are
grouped the same way.

Bash never traces a line that runs no command: an empty case branch
(`200) ;;`), a `fi ;;` or `esac ;;` closing a branch, or the `}` or `done` that
redirects a block. kcov still lists those lines, so they are grouped with the
statement above them too.

Usage: scripts/coverage-report CODECOV_JSON ROOT [--min PERCENT] [--files TSV]
"""
import argparse
import json
import re
import sys
from pathlib import Path

HEREDOC = re.compile(r"<<(-?)\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\2")
NO_COMMAND = re.compile(
    r"\s*(?:\(?[^\s()#;][^()#;]*\)\s*;;"        # empty case branch: pattern) ;;
    r"|(?:fi|done|esac|\})\s*;;"                   # block closed inside a branch
    r"|(?:done|\})\s*[0-9]*[<>].*)\s*(?:#.*)?")    # block closed with a redirection


def continuation_lines(text):
    """Return 1-based line numbers that continue a statement started earlier."""
    skip = set()
    quote = None          # "'" or '"' while inside a string spanning lines
    substitution_depth = 0
    substitution_quote = None
    heredocs = []         # pending (terminator, strip_tabs) for the next lines
    in_heredoc = None
    continued = False
    array_depth = 0       # open parentheses of a NAME=( array assignment
    for number, line in enumerate(text.split("\n"), start=1):
        if in_heredoc:
            skip.add(number)
            terminator, strip = in_heredoc
            if (line.lstrip("\t") if strip else line) == terminator:
                in_heredoc = heredocs.pop(0) if heredocs else None
            continue
        if quote or continued or substitution_depth or array_depth or NO_COMMAND.fullmatch(line):
            skip.add(number)
        continued = False
        i = 0
        while i < len(line):
            char = line[i]
            if substitution_depth:
                if substitution_quote == "'":
                    if char == "'":
                        substitution_quote = None
                elif substitution_quote == '"':
                    if char == "\\":
                        i += 1
                    elif char == '"':
                        substitution_quote = None
                elif line.startswith("$(", i):
                    substitution_depth += 1
                    i += 1
                elif char == "'" or char == '"':
                    substitution_quote = char
                elif char == ")":
                    substitution_depth -= 1
                i += 1
                continue
            if line.startswith("$(", i) and quote != "'":
                substitution_depth = 1
                i += 2
                continue
            if quote == "'":
                if char == "'":
                    quote = None
            elif quote == '"':
                if char == "\\":
                    i += 1
                elif char == '"':
                    quote = None
            elif char == "\\":
                if i == len(line) - 1:
                    continued = True
                i += 1
            elif char in "'\"":
                quote = char
            elif char == "(" and (array_depth or (i > 0 and line[i - 1] == "=")):
                array_depth += 1
            elif char == ")" and array_depth:
                array_depth -= 1
            elif char == "#" and (i == 0 or line[i - 1] in " \t;|&("):
                break
            elif char == "<" and line.startswith("<<", i) and not line.startswith("<<<", i):
                match = HEREDOC.match(line, i)
                if match:
                    heredocs.append((match.group(3), match.group(1) == "-"))
                    i = match.end() - 1
            i += 1
        if heredocs and not quote:
            in_heredoc = heredocs.pop(0)
    return skip


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("codecov")
    parser.add_argument("root")
    parser.add_argument("--min", type=float, default=0.0)
    parser.add_argument("--files", help="write per-file coverage as TSV")
    args = parser.parse_args()
    root = Path(args.root).resolve()
    coverage = json.loads(Path(args.codecov).read_text())["coverage"]

    rows = []
    for path, lines in coverage.items():
        source = Path(path)
        if not source.is_file():
            continue
        skip = continuation_lines(source.read_text(errors="replace"))
        counted = {int(n): hits for n, hits in lines.items() if int(n) not in skip}
        if not counted:
            continue
        starts = sorted(counted)
        covered = 0
        for index, start in enumerate(starts):
            end = starts[index + 1] if index + 1 < len(starts) else float("inf")
            group_hits = [hits for number, hits in lines.items() if start <= int(number) < end]
            if any(int(str(hits).split("/")[0]) > 0 for hits in group_hits):
                covered += 1
        rows.append((covered, len(counted), str(source.resolve().relative_to(root))))

    covered = sum(row[0] for row in rows)
    total = sum(row[1] for row in rows)
    percent = 100.0 * covered / total if total else 0.0
    if args.files:
        rows.sort(key=lambda row: (row[0] / row[1], row[2]))
        with open(args.files, "w") as out:
            for hit, count, name in rows:
                out.write(f"{100.0 * hit / count:.2f}%\t{hit}/{count}\t{name}\n")
    print(f"Statement coverage: {percent:.2f}% ({covered}/{total} statements in {len(rows)} files)")
    if percent < args.min:
        print(f"Coverage {percent:.2f}% is below the {args.min:g}% minimum", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
