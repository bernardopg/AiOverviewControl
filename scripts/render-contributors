#!/usr/bin/env bash
# Rewrites the contributor avatar grid between the CONTRIBUTORS markers in every
# README variant. Avatars only, no names or commit counts: this list used to be
# hand-maintained prose and went stale on every merge.
#
# The grid is append-only. GitHub's contributors API drops people whose commit
# email stops resolving to their account (their commits turn "anonymous"), so a
# fresh API listing is never allowed to remove anyone already credited:
#   1. everyone already in README.md keeps their place, in order;
#   2. new contributors from the API are appended;
#   3. PINNED logins are always present, rebuilt from their profile if missing.
# Only EXCLUDED automation accounts are ever removed. See CONTRIBUTING.md.
set -euo pipefail

REPO="${GITHUB_REPOSITORY:-bernardopg/AiOverviewControl}"
AVATAR_SIZE="${AVATAR_SIZE:-56}"
START="<!-- CONTRIBUTORS:START - generated by scripts/render-contributors -->"
END="<!-- CONTRIBUTORS:END -->"
FILES=("README.md" "docs/README.pt-BR.md")
# Credited contributors who must never disappear from the grid.
PINNED="SkippySteve"
# Coding assistants committing under a vendor noreply address map to a regular
# "User" account; bots are filtered by type.
EXCLUDED="claude Copilot copilot-swe-agent codex devin-ai-integration"

cd "$(dirname "${BASH_SOURCE[0]}")/.."

api="$(gh api "repos/${REPO}/contributors?per_page=100" --paginate \
  --jq '.[] | select(.type == "User") | [.login, .html_url, .avatar_url] | @tsv')"
[ -n "$api" ] || { echo "No contributors returned for ${REPO}" >&2; exit 1; }

pinned_profiles=""
for login in $PINNED; do
  pinned_profiles+="$(gh api "users/${login}" --jq '[.login, .html_url, .avatar_url] | @tsv')"$'\n'
done

grid="$(API="$api" PINNED_PROFILES="$pinned_profiles" EXCLUDED="$EXCLUDED" \
  START="$START" END="$END" SIZE="$AVATAR_SIZE" python3 - "${FILES[0]}" <<'PY'
import os
import re
import sys

size = os.environ["SIZE"]
excluded = set(os.environ["EXCLUDED"].split())

def entry(login, url, avatar):
    return (f'<a href="{url}" title="{login}"><img src="{avatar}&s=112" '
            f'width="{size}" height="{size}" alt="{login}" /></a>')

def rows(text):
    return [line.split("\t") for line in text.splitlines() if line.strip()]

readme = open(sys.argv[1], encoding="utf-8").read()
try:
    current = readme.split(os.environ["START"], 1)[1].split(os.environ["END"], 1)[0]
except IndexError:
    sys.exit(f"{sys.argv[1]} has no CONTRIBUTORS markers")

grid, seen = [], set()
for line in current.splitlines():
    match = re.search(r'title="([^"]+)"', line)
    if match and match.group(1) not in excluded and match.group(1) not in seen:
        seen.add(match.group(1))
        grid.append(line.strip())
for login, url, avatar in rows(os.environ["API"]) + rows(os.environ["PINNED_PROFILES"]):
    if login not in excluded and login not in seen:
        seen.add(login)
        grid.append(entry(login, url, avatar))
print("\n".join(grid))
PY
)"

for file in "${FILES[@]}"; do
  [ -f "$file" ] || continue
  START="$START" END="$END" GRID="$grid" python3 - "$file" <<'PY'
import os
import sys

path = sys.argv[1]
start, end, grid = os.environ["START"], os.environ["END"], os.environ["GRID"]
text = open(path, encoding="utf-8").read()
if start not in text or end not in text:
    sys.exit(f"{path} has no CONTRIBUTORS markers")
head, rest = text.split(start, 1)
_, tail = rest.split(end, 1)
open(path, "w", encoding="utf-8").write(f"{head}{start}\n\n{grid}\n\n{end}{tail}")
PY
  echo "Updated ${file}"
done
