#!/usr/bin/env bash
# Measure statement coverage of the shell adapters and scripts with kcov.
# Usage: scripts/coverage [OUTPUT_DIR]; AIOC_COVERAGE_MIN=95 fails below 95%,
# AIOC_COVERAGE_JOBS sets the parallel suites (default: CPU count).
# Requires kcov and python3.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-$ROOT/coverage}"
MIN="${AIOC_COVERAGE_MIN:-0}"
command -v kcov >/dev/null || { echo "kcov is required" >&2; exit 2; }
rm -rf "$OUT"
mkdir -p "$OUT/runs"
cd "$ROOT"

# One kcov run per suite, in parallel: suites use their own temp dirs, and a
# serial run takes longer than a CI job allows.
run_one() {
    local test="$1" name
    name="$(basename "$test" .sh)"
    # A suite that hangs under kcov fails on its own instead of stalling CI.
    if timeout "${AIOC_COVERAGE_TIMEOUT:-300}" kcov --include-path="$ROOT/providers,$ROOT/scripts" \
        --exclude-path="$ROOT/scripts/coverage,$ROOT/scripts/coverage-report" \
        --bash-parse-files-in-dir="$ROOT/providers,$ROOT/scripts" \
        "$OUT/runs/$name" "$test" </dev/null >"$OUT/runs/$name.log" 2>&1; then
        echo "ok   $name"
    else
        echo "FAIL under kcov (exit $?): $test" >&2
        tail -n 20 "$OUT/runs/$name.log" >&2
        touch "$OUT/failed"
    fi
}
export -f run_one
export ROOT OUT
# QML suites exercise Quickshell components, not the shell adapters.
find tests -maxdepth 1 -name 'test-*.sh' \
    ! -name test-widget-runtime.sh ! -name test-qml-smoke.sh ! -name test-currency-qml.sh -print0 \
    | sort -z | xargs -0 -n 1 -P "${AIOC_COVERAGE_JOBS:-$(nproc)}" bash -c 'run_one "$1"' _
kcov --merge "$OUT/merged" "$OUT"/runs/test-*/ >/dev/null
[[ ! -e "$OUT/failed" ]] || exit 1
# kcov's raw percentage counts the bodies of embedded jq/awk programs and
# heredocs as unexecuted statements; coverage-report counts statements only.
"$ROOT/scripts/coverage-report" "$OUT/merged/kcov-merged/codecov.json" "$ROOT" \
    --min "$MIN" --files "$OUT/files.tsv"
echo "Per file: $OUT/files.tsv"
