{
  "name": "main: reviewed delivery and complete changelog",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"include": ["refs/heads/main"], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 0,
      "dismiss_stale_reviews_on_push": true,
      "require_code_owner_review": false,
      "require_last_push_approval": false,
      "required_review_thread_resolution": true
    }},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": true,
      "required_status_checks": [
        {"context": "Changelog integrity", "integration_id": 15368},
        {"context": "Metadata", "integration_id": 15368},
        {"context": "Workflow lint", "integration_id": 15368},
        {"context": "Release packaging", "integration_id": 15368},
        {"context": "Shell scripts", "integration_id": 15368},
        {"context": "Integration tests", "integration_id": 15368},
        {"context": "QML lint", "integration_id": 15368},
        {"context": "Quickshell component smoke", "integration_id": 15368},
        {"context": "Crowdin config", "integration_id": 15368}
      ]
    }}
  ]
}
